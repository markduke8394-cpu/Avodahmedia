# Application
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=avodahmedia_leads
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRATION=7d

# Twilio SMS
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
OWNER_PHONE_NUMBER=+1234567890

# Platform API Keys (LinkedIn)
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token

# Platform API Keys (Facebook/Meta)
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token
FACEBOOK_PAGE_ID=your_facebook_page_id
FACEBOOK_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# Platform API Keys (Yelp)
YELP_API_KEY=your_yelp_api_key
YELP_BUSINESS_ID=your_yelp_business_id

# Platform API Keys (Email)
EMAIL_SERVICE=zapier
EMAIL_WEBHOOK_TOKEN=your_email_webhook_token

# Redis (optional for caching)
REDIS_URL=redis://localhost:6379

# Encryption
ENCRYPTION_KEY=your_32_char_encryption_key_here_

# CORS
CORS_ORIGIN=http://localhost:3000

# Session
SESSION_SECRET=your_session_secret_here
